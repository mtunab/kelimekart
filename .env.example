# Bu dosyayı ".env.local" adıyla kopyala ve değerleri doldur.
# .env.local asla GitHub'a gönderilmez (.gitignore içinde).
# Burada sadece DEV Supabase projesinin bilgileri olur.

# Supabase paneli → Project Settings → API (veya "Connect" düğmesi)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# "anon public" anahtarı veya yeni "publishable" anahtarı (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GİZLİ: sadece scripts/ ve testler kullanır. Asla NEXT_PUBLIC_ ile başlatma.
# "service_role" anahtarı veya yeni "secret" anahtarı (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# Migration'ları uygulamak için veritabanı adresi (şifresiz hali).
# Panel → "Connect" → "Direct" → "Session pooler" adresini [YOUR-PASSWORD] yazısıyla birlikte olduğu gibi yapıştır.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# GİZLİ: veritabanı şifresi, olduğu gibi (özel işaretler sorun değil, betik kodlar).
SUPABASE_DB_PASSWORD=
